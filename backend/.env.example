# ==========================================
# BACKEND ENVIRONMENT VARIABLES TEMPLATE (PRODUCTION / DEPLOYMENT)
# Copy isi file ini ke Environment Variables pada platform hosting (Railway / Render / Vercel Serverless)
# ==========================================

# 1. Server Configuration
PORT=5000
NODE_ENV=production

# 2. Frontend URL & CORS Whitelist Configuration
# Masukkan URL Production Frontend Vercel milik Anda
FRONTEND_URL=https://eventhub-kampus.vercel.app
CORS_ORIGIN=https://eventhub-kampus.vercel.app,http://localhost:5173

# 3. Supabase Database & Auth Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:password@db.xxx.supabase.com:5432/postgres"

# 4. JWT Authentication Policy & Secrets
# Generate random 64-char string via 'openssl rand -hex 32'
JWT_SECRET=your_super_secret_jwt_key_here_generate_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
